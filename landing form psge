<!DOCTYPE html>
ml lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Unlock Focus | FocusPro</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .fade-in {
      opacity: 0;
      transform: translateY(20px);
      animation: fadeInUp 1.5s ease-in-out forwards;
      animation-delay: 4s;
    }

    @keyframes fadeInUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .hide-link {
      opacity: 0.3;
      font-size: 0.8rem;
    }

    .hide-link:hover {
      opacity: 0.6;
    }
  </style>
</head>
<body class="bg-gray-100 text-gray-900">
  <div class="min-h-screen flex flex-col items-center justify-center p-4">
    <div class="max-w-lg w-full bg-white rounded-2xl shadow-2xl p-8 text-center">
      <h1 class="text-3xl font-bold text-blue-800 mb-2">Unlock 2x Focus in 7 Days</h1>
      <p class="text-gray-700 mb-4">Join <span class="text-green-600 font-semibold">24,928+ high-performers</span> using FocusPro.</p>
      <p class="text-red-600 font-semibold mb-6">Only 2 free trials left today. Act fast.</p>

      <form id="lead-form" class="space-y-4">
        <input type="text" placeholder="Full Name" required class="w-full border border-gray-300 p-3 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600">
        <input type="email" placeholder="Email Address" required class="w-full border border-gray-300 p-3 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600">
        <label class="flex items-start text-sm text-gray-500">
          <input type="checkbox" checked class="mt-1 mr-2">
          Keep me updated with tips and exclusive hacks.
        </label>

        <!-- Delayed CTA -->
        <div id="cta-wrapper" class="fade-in">
          <button type="submit" class="w-full bg-orange-600 text-white font-semibold p-3 rounded-xl hover:bg-orange-700 transition">
            Claim Your Free Trial
          </button>
        </div>

        <p class="text-xs text-gray-400 mt-2">
          You agree to our <a href="#" class="underline">Terms & Privacy</a> by signing up.
        </p>
      </form>

      <!-- Obscure opt-out -->
      <div class="mt-4">
        <a href="#" class="hide-link">No thanks, I’ll stay distracted</a>
      </div>
    </div>
  </div>
</body>
</html>

